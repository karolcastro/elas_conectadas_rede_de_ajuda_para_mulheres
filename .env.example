# O conector do IBGE não exige chave de API.
# Não coloque credenciais reais neste arquivo.

# HTTP deployment only. Configure real values in Vercel Environment Variables.
# ELAS_MCP_BEARER_TOKEN=generate-a-long-random-secret
# ELAS_MCP_ALLOWED_HOSTS=localhost:8000
# ELAS_MCP_ALLOWED_ORIGINS=http://localhost:8000
